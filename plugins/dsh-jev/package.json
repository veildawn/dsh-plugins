{
  "name": "dsh-jev",
  "version": "0.1.4",
  "private": true,
  "description": "TypeSafe Jev (System One 决策模型) 原生工具插件：70ms 极速结构化决策、意图分流与状态打分，支持前端设置 API Key。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "jev",
    "typesafe",
    "system-one"
  ],
  "scripts": {
    "test": "node test/smoke.mjs",
    "test:policy": "node test/policy-section.mjs",
    "test:loader": "node test/loader-overlay.mjs",
    "test:fixture": "node test/fixture-check.mjs"
  }
}
