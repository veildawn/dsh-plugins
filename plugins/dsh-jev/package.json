{
  "name": "@weniatall/dsh-jev",
  "version": "0.2.9",
  "description": "决策模型原生工具插件：70ms 极速结构化决策、意图分流与状态打分。可直接下拉选择 dsh 已配置的提供商与模型（接口地址与 API Key 由提供商配置解析），也可手写 baseUrl / API Key / 模型 ID；决策模型按 /v1/models 的 modality 字段、静态 modality 与 classifier 协议识别；默认仍为 TypeSafe Jev 官方地址，支持 /v1/systemone 与 /v1/decisions 端点。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./provider": "./lib/provider.js",
    "./settings": "./lib/settings.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "jev",
    "typesafe",
    "system-one",
    "decision-model"
  ],
  "scripts": {
    "test": "node test/provider.mjs && node test/settings.mjs && node test/smoke.mjs && node test/proxy.mjs && node test/provider-mode.mjs && node test/client-render.mjs",
    "test:provider": "node test/provider.mjs",
    "test:settings": "node test/settings.mjs",
    "test:provider-mode": "node test/provider-mode.mjs",
    "test:proxy": "node test/proxy.mjs",
    "test:client": "node test/client-render.mjs",
    "test:policy": "node test/policy-section.mjs",
    "test:loader": "node test/loader-overlay.mjs",
    "test:fixture": "node test/fixture-check.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veildawn/dsh-plugins.git",
    "directory": "plugins/dsh-jev"
  },
  "homepage": "https://github.com/veildawn/dsh-plugins/tree/main/plugins/dsh-jev#readme",
  "bugs": {
    "url": "https://github.com/veildawn/dsh-plugins/issues"
  }
}
