{
  "name": "@weniatall/dsh-mobile-adapter",
  "version": "0.1.67",
  "description": "Zero-intrusion mobile drawer and responsive layout adapter for DeepSeek Harness Web",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "mobile",
    "responsive"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-trajectory"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veildawn/dsh-plugins.git",
    "directory": "plugins/dsh-mobile-adapter"
  },
  "homepage": "https://github.com/veildawn/dsh-plugins/tree/main/plugins/dsh-mobile-adapter#readme",
  "bugs": {
    "url": "https://github.com/veildawn/dsh-plugins/issues"
  },
  "engines": {
    "node": ">=20.3"
  }
}
