{
  "name": "@weniatall/dsh-zcode-theme",
  "version": "0.3.0",
  "description": "Deprecated compatibility shell for the ZCode visual theme, now built into @weniatall/dsh-theme-studio",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./tokens": "./lib/tokens.js",
    "./css": "./lib/css.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/tokens.js",
    "lib/css.js",
    "lib/client.js",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "theme",
    "zcode",
    "deprecated"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6",
    "@weniatall/dsh-theme-studio": ">=0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veildawn/dsh-plugins.git",
    "directory": "plugins/dsh-zcode-theme"
  },
  "homepage": "https://github.com/veildawn/dsh-plugins/tree/main/plugins/dsh-zcode-theme#readme",
  "bugs": {
    "url": "https://github.com/veildawn/dsh-plugins/issues"
  },
  "engines": {
    "node": ">=20.3"
  },
  "deprecated": "Merged into @weniatall/dsh-theme-studio (built-in themes: zcode, zcode-mono). Install that package instead.",
  "dependencies": {
    "@weniatall/dsh-theme-studio": "workspace:*"
  }
}
