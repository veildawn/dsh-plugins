{
  "name": "@weniatall/dsh-repo-wiki",
  "version": "0.2.4",
  "description": "Qoder Repo Wiki 等价的仓库知识库插件：在宿主内用 ctx.llm 跑「目录规划 → 逐页写作」两阶段流水线，把结构化 Markdown 知识库落进仓库的 <dataDir>/repowiki，沿用 Qoder 的状态机、目录模型、导出布局与 wiki_plan.yaml 语义，并提供六个 *_wiki 工具与左侧全局面板。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/tools.js",
    "./client": "./lib/client.js",
    "./constants": "./lib/constants.js",
    "./status": "./lib/status.js",
    "./plan": "./lib/plan.js",
    "./scan": "./lib/scan.js",
    "./store": "./lib/store.js",
    "./pipeline": "./lib/pipeline.js",
    "./ops": "./lib/ops.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/repo-wiki.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "presets",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "repo-wiki",
    "knowledge-base",
    "documentation",
    "qoder"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent-preset": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veildawn/dsh-plugins.git",
    "directory": "plugins/dsh-repo-wiki"
  },
  "homepage": "https://github.com/veildawn/dsh-plugins/tree/main/plugins/dsh-repo-wiki#readme",
  "bugs": {
    "url": "https://github.com/veildawn/dsh-plugins/issues"
  }
}
