{
  "name": "@weniatall/dsh-dynamic-workflow",
  "version": "0.1.5",
  "description": "动态编排可视化：把 workflow 工具的每次运行折成 phase 泳道 + agent 节点的实时编排卡片，像任务列表一样浮在输入框上方；支持把脚本保存为项目/全局 workflow 并用 /workflow 重新启动（对齐 ZCode /workflow）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./store": "./lib/store.js",
    "./library": "./lib/library.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workflow",
    "orchestration",
    "visualization"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veildawn/dsh-plugins.git",
    "directory": "plugins/dsh-dynamic-workflow"
  },
  "homepage": "https://github.com/veildawn/dsh-plugins/tree/main/plugins/dsh-dynamic-workflow#readme",
  "bugs": {
    "url": "https://github.com/veildawn/dsh-plugins/issues"
  },
  "engines": {
    "node": ">=20.3"
  }
}
