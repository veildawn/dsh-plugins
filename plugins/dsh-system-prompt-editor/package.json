{
  "name": "@weniatall/dsh-system-prompt-editor",
  "version": "0.3.4",
  "description": "Visual editor for the DeepSeek Harness system prompt: inspect the assembled prompt, then append, replace or remove sections with persistent, per-preset rules",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/core.js",
    "lib/client.js",
    "README.md",
    "cordis.patch.yml",
    "docs/DESIGN.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "system-prompt",
    "prompt-engineering",
    "persona",
    "settings"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veildawn/dsh-plugins.git",
    "directory": "plugins/dsh-system-prompt-editor"
  },
  "homepage": "https://github.com/veildawn/dsh-plugins/tree/main/plugins/dsh-system-prompt-editor#readme",
  "bugs": {
    "url": "https://github.com/veildawn/dsh-plugins/issues"
  },
  "engines": {
    "node": ">=20.3"
  }
}
