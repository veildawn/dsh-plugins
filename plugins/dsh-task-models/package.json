{
  "name": "@weniatall/dsh-task-models",
  "version": "0.2.2",
  "description": "子任务模型路由插件：按任务类型为子代理选择模型，规则命中零额外调用，可选 TypeSafe Jev 决策与轻量分类回退，并标注 workflow 成员实际模型。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./core": "./lib/core.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && node ../../scripts/check-host-settings.mjs plugins/dsh-task-models task-models"
  },
  "files": [
    "lib/index.js",
    "lib/core.js",
    "lib/client.js",
    "README.md",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "task-models",
    "subagent",
    "routing",
    "jev",
    "typesafe"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veildawn/dsh-plugins.git",
    "directory": "plugins/dsh-task-models"
  },
  "homepage": "https://github.com/veildawn/dsh-plugins/tree/main/plugins/dsh-task-models#readme",
  "bugs": {
    "url": "https://github.com/veildawn/dsh-plugins/issues"
  }
}
